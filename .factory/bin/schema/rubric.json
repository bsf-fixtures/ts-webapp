{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/rubric.json",
  "title": "Scorer rubric",
  "description": "How the scheduled review grades work. One per pipeline plus shared. Doc 09.",
  "type": "object",
  "required": ["schema", "criteria", "scale", "failure_tags"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "rubric/1" },
    "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
    "shared": { "type": "boolean" },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "question": { "type": "string" }
        }
      }
    },
    "scale": { "const": "1-5" },
    "failure_tags": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
  }
}
