{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/benchmark-result.json",
  "title": "Benchmark comparison result",
  "description": "One benchmark comparison: each configuration tried, its score and its cost, and whether the change was admitted. Written so the Improvement page can plot cost against quality without re-running anything. Doc 09.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "at",
    "repeats",
    "task_count",
    "sides",
    "admitted",
    "reasons"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "benchmark-result/1"
    },
    "id": {
      "$ref": "_common.json#/$defs/benchmarkResultId"
    },
    "at": {
      "$ref": "_common.json#/$defs/timestamp"
    },
    "repeats": {
      "type": "integer",
      "minimum": 1
    },
    "task_count": {
      "type": "integer",
      "minimum": 1
    },
    "pipeline": {
      "$ref": "_common.json#/$defs/pipeline"
    },
    "pr": {
      "type": "integer",
      "description": "The definition pull request this comparison justified, when there is one."
    },
    "sides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "label",
          "score_mean",
          "score_spread",
          "cost_usd",
          "cost_per_task",
          "must_pass_rate"
        ],
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1
          },
          "models": {
            "type": "object",
            "description": "The model per role this side ran with, so a point on the chart names a configuration rather than a side of one comparison.",
            "additionalProperties": {
              "type": "string"
            }
          },
          "score_mean": {
            "type": "number",
            "minimum": 0
          },
          "score_spread": {
            "type": "number",
            "minimum": 0,
            "description": "Highest minus lowest mean across repeats. A difference between sides smaller than this is inside the noise."
          },
          "cost_usd": {
            "type": "number",
            "minimum": 0
          },
          "cost_per_task": {
            "type": "number",
            "minimum": 0
          },
          "must_pass_rate": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "current": {
            "type": "boolean",
            "description": "True for the configuration the factory is running now."
          }
        }
      }
    },
    "admitted": {
      "type": "boolean"
    },
    "reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "regressed": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Task ids that stopped passing a check the reference merge passed. Any entry is a veto, whatever the scores say."
    }
  }
}
