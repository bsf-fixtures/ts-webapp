{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/_common.json",
  "title": "Shared definitions",
  "$defs": {
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "workItemId": {
      "type": "string",
      "pattern": "^wi_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "runId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "reviewId": {
      "type": "string",
      "pattern": "^rev_[0-9]{8}$"
    },
    "benchmarkTaskId": {
      "type": "string",
      "pattern": "^bt_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "benchmarkResultId": {
      "type": "string",
      "pattern": "^bench_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^cand_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "usd": {
      "type": "number",
      "minimum": 0
    },
    "seconds": {
      "type": "integer",
      "minimum": 0
    },
    "pct": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "ratio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$"
    },
    "harness": {
      "type": "string",
      "enum": [
        "claude-code",
        "cursor-cli",
        "kilo-code",
        "pi",
        "hermes-agent"
      ]
    },
    "pipeline": {
      "type": "string",
      "enum": [
        "product_work",
        "gardening",
        "hardening",
        "definition",
        "conflict"
      ]
    },
    "role": {
      "type": "string",
      "enum": [
        "triage",
        "spec",
        "builder",
        "verifier",
        "gardener",
        "hardener",
        "scorer"
      ]
    },
    "triggerClass": {
      "type": "string",
      "enum": [
        "request",
        "dev_event",
        "signal",
        "scheduled",
        "self"
      ]
    }
  }
}
