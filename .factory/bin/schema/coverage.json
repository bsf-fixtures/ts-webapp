{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/coverage.json",
  "title": "Coverage ratchet",
  "description": "Coverage floor, high mark, diff minimum and skip cap. Doc 09.",
  "type": "object",
  "required": ["schema", "high_pct", "floor_pct", "tolerance_pts", "diff_min_pct", "skips"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "coverage/1" },
    "high_pct": { "$ref": "_common.json#/$defs/pct" },
    "floor_pct": { "$ref": "_common.json#/$defs/pct" },
    "tolerance_pts": { "type": "number", "minimum": 0 },
    "diff_min_pct": { "$ref": "_common.json#/$defs/pct" },
    "skips": {
      "type": "object",
      "required": ["count", "cap"],
      "additionalProperties": false,
      "properties": {
        "count": { "type": "integer", "minimum": 0 },
        "cap": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
