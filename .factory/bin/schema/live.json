{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/live.json",
  "title": "Live status",
  "description": "One small file per in-progress run on refs/factory/live/<run-id>, force-updated at each step change and deleted at run end. Doc 09.",
  "type": "object",
  "required": ["schema", "run", "work_item", "pipeline", "step", "started_at"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "live/1" },
    "run": { "$ref": "_common.json#/$defs/runId" },
    "work_item": { "$ref": "_common.json#/$defs/workItemId" },
    "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
    "step": { "type": "string", "enum": ["triage", "spec", "builder", "verifier", "gardener", "hardener", "scorer", "gate", "merge"] },
    "gate": { "type": ["string", "null"], "enum": ["static", "verification", null] },
    "attempt": { "type": "integer", "minimum": 1 },
    "of": { "type": "integer", "minimum": 1 },
    "started_at": { "$ref": "_common.json#/$defs/timestamp" },
    "cost_usd_so_far": { "$ref": "_common.json#/$defs/usd" }
  }
}
