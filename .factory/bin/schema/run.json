{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/run.json",
  "title": "Run file",
  "description": "One file per run, written once at run end. Doc 09.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "work_item",
    "pipeline",
    "actor",
    "started_at",
    "ended_at",
    "outcome",
    "steps",
    "gates",
    "cost_usd"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "run/1"
    },
    "id": {
      "$ref": "_common.json#/$defs/runId"
    },
    "work_item": {
      "$ref": "_common.json#/$defs/workItemId"
    },
    "pipeline": {
      "$ref": "_common.json#/$defs/pipeline"
    },
    "actor": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "agent",
            "human"
          ]
        },
        "harness": {
          "$ref": "_common.json#/$defs/harness"
        },
        "login": {
          "type": "string"
        }
      }
    },
    "started_at": {
      "$ref": "_common.json#/$defs/timestamp"
    },
    "ended_at": {
      "$ref": "_common.json#/$defs/timestamp"
    },
    "duration_sec": {
      "$ref": "_common.json#/$defs/seconds"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "draft_pr",
        "merged",
        "escalated",
        "duplicate",
        "failed",
        "cancelled",
        "rejected",
        "no_action"
      ]
    },
    "pr": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "$ref": "_common.json#/$defs/role"
          },
          "model": {
            "type": "string"
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "duration_sec": {
            "$ref": "_common.json#/$defs/seconds"
          },
          "tokens": {
            "type": "object",
            "required": [
              "in",
              "out"
            ],
            "additionalProperties": false,
            "properties": {
              "in": {
                "type": "integer",
                "minimum": 0
              },
              "out": {
                "type": "integer",
                "minimum": 0
              },
              "cached": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "cost_usd": {
            "$ref": "_common.json#/$defs/usd"
          },
          "transcript": {
            "type": [
              "string",
              "null"
            ]
          },
          "exit": {
            "type": "string",
            "enum": [
              "ok",
              "error",
              "timeout",
              "refused"
            ]
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "gate",
          "attempt",
          "result"
        ],
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "enum": [
              "static",
              "verification"
            ]
          },
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "commit": {
            "$ref": "_common.json#/$defs/gitSha"
          },
          "result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "skipped"
            ]
          },
          "failures": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "rule"
              ],
              "additionalProperties": false,
              "properties": {
                "rule": {
                  "type": "string"
                },
                "file": {
                  "type": "string"
                },
                "line": {
                  "type": "integer",
                  "minimum": 1
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "coverage": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "diff_pct": {
                "$ref": "_common.json#/$defs/pct"
              },
              "total_pct": {
                "$ref": "_common.json#/$defs/pct"
              }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stored": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "path"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "screenshot",
                  "clip",
                  "diagram"
                ]
              },
              "path": {
                "type": "string"
              },
              "caption": {
                "type": "string"
              },
              "expires_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "expiring": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "kind",
              "artifact_id"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "video",
                  "log",
                  "trace"
                ]
              },
              "artifact_id": {
                "type": "integer"
              },
              "expires_at": {
                "type": "string",
                "format": "date"
              }
            }
          }
        }
      }
    },
    "cost_usd": {
      "$ref": "_common.json#/$defs/usd"
    },
    "escalated": {
      "type": "boolean"
    },
    "human_interactions": {
      "type": "object",
      "description": "How much steering this run's PR needed from a person, counted when the PR merged. An approving review is the gate working as designed and is not counted; a comment, a change request, or a human commit on the branch are. Absent means not measured, which the rollup does not read as zero.",
      "required": [
        "comments",
        "change_requests",
        "human_commits",
        "total"
      ],
      "additionalProperties": false,
      "properties": {
        "comments": {
          "type": "integer",
          "minimum": 0
        },
        "change_requests": {
          "type": "integer",
          "minimum": 0
        },
        "human_commits": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
