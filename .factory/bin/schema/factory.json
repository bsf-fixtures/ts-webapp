{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/factory.json",
  "title": "Factory config",
  "description": "factory.yaml — how the factory runs. Part of the factory definition, so changes need a trusted human's approval. Doc 09.",
  "type": "object",
  "required": ["schema", "harness", "models", "pipelines", "limits", "budget", "data", "enforcement"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "factory/1" },
    "harness": { "$ref": "_common.json#/$defs/harness" },
    "models": {
      "type": "object",
      "required": ["triage", "spec", "builder", "verifier", "gardener", "hardener", "scorer"],
      "additionalProperties": false,
      "properties": {
        "triage": { "type": "string" }, "spec": { "type": "string" },
        "builder": { "type": "string" }, "verifier": { "type": "string" },
        "gardener": { "type": "string" }, "hardener": { "type": "string" },
        "scorer": { "type": "string" }
      }
    },
    "pipelines": {
      "type": "object",
      "required": ["product_work", "gardening", "hardening"],
      "additionalProperties": false,
      "properties": {
        "product_work": {
          "type": "object", "additionalProperties": false,
          "properties": { "auto_merge": { "type": "boolean" } }
        },
        "gardening": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "auto_merge": { "type": "boolean" },
            "schedule": { "type": "string" },
            "max_prs_per_run": { "type": "integer", "minimum": 1 }
          }
        },
        "hardening": {
          "type": "object", "additionalProperties": false,
          "properties": { "auto_merge": { "type": "boolean" } }
        }
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "every_days": { "type": "integer", "minimum": 1 },
        "run_early_at_runs": { "type": "integer", "minimum": 1 },
        "skip_below_runs": { "type": "integer", "minimum": 0 }
      }
    },
    "limits": {
      "type": "object",
      "required": ["retry_cap", "step_time_budget_sec", "concurrency"],
      "additionalProperties": false,
      "properties": {
        "retry_cap": { "type": "integer", "minimum": 1 },
        "step_time_budget_sec": { "$ref": "_common.json#/$defs/seconds" },
        "concurrency": {
          "type": "object", "required": ["max_runs"], "additionalProperties": false,
          "properties": { "max_runs": { "type": "integer", "minimum": 1 } }
        }
      }
    },
    "budget": {
      "type": "object",
      "required": ["monthly_usd", "shares"],
      "additionalProperties": false,
      "properties": {
        "monthly_usd": { "$ref": "_common.json#/$defs/usd" },
        "monthly_actions_minutes": { "type": ["number", "null"], "minimum": 0 },
        "shares": {
          "type": "object",
          "required": ["product_work", "gardening", "review_and_benchmarks"],
          "additionalProperties": false,
          "properties": {
            "product_work": { "$ref": "_common.json#/$defs/pct" },
            "gardening": { "$ref": "_common.json#/$defs/pct" },
            "review_and_benchmarks": { "$ref": "_common.json#/$defs/pct" }
          }
        },
        "product_work_hard_stop_pct": { "type": "number", "minimum": 100 }
      }
    },
    "triggers": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "issues": { "type": "boolean" }, "comments": { "type": "boolean" },
        "ci_failure_on_main": { "type": "boolean" }, "dashboard_dispatch": { "type": "boolean" }
      }
    },
    "data": {
      "type": "object",
      "required": ["location", "sessions"],
      "additionalProperties": false,
      "properties": {
        "location": { "type": "string", "enum": ["same_repo", "repo"] },
        "repo": { "type": ["string", "null"], "pattern": "^[^/]+/[^/]+$" },
        "sessions": { "type": "string", "enum": ["auto", "off"] },
        "media_retention_months": { "type": "integer", "minimum": 1 }
      },
      "allOf": [{
        "if": { "properties": { "location": { "const": "repo" } }, "required": ["location"] },
        "then": { "properties": { "repo": { "type": "string" } }, "required": ["repo"] }
      }]
    },
    "enforcement": {
      "type": "object",
      "required": ["merge_queue", "branch_protection"],
      "additionalProperties": false,
      "properties": {
        "merge_queue": { "type": "string", "enum": ["auto", "native", "fallback"] },
        "branch_protection": { "type": "string", "enum": ["auto", "on", "off"] },
        "audit_revert_pr": { "type": "boolean" }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "description": "Set at setup from whether the repo's app needs an Actions services: sidecar. The weaker profile runs AWF with host privileges (spike §4a).",
      "properties": {
        "agent_runtime": { "type": "string", "enum": ["docker", "docker-sudo-iptables"] },
        "allow_host_ports": { "type": "array", "items": { "type": "integer" } }
      }
    },
    "human_prs": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "gates": { "type": "string", "enum": ["deterministic", "all"] },
        "verify_label": { "type": "string" }
      }
    },
    "existing_ci": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "test_check": { "type": ["string", "null"] },
        "wait_minutes": { "type": "integer", "minimum": 1 }
      }
    },
    "recompiler": {
      "type": "object", "additionalProperties": false,
      "description": "The second, minimal App that recompiles gh-aw lock files in Actions (spike §5). Absent means the skill's repair mode is the upgrade path.",
      "properties": {
        "enabled": { "type": "boolean" },
        "ghaw_version": { "type": "string" }
      }
    }
  }
}
