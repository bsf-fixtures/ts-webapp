{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/benchmark-task.json",
  "title": "Benchmark task",
  "description": "A frozen copy of real past work: the repo state before, the request, and the known-good result to grade against. Doc 09.",
  "type": "object",
  "required": ["schema", "id", "source_run", "origin", "pipeline", "base_commit", "request", "reference", "grading"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "benchmark-task/1" },
    "id": { "$ref": "_common.json#/$defs/benchmarkTaskId" },
    "source_run": { "$ref": "_common.json#/$defs/runId" },
    "origin": { "type": "string", "enum": ["succeeded", "corrected", "escalated", "representative"] },
    "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
    "base_commit": { "$ref": "_common.json#/$defs/gitSha" },
    "created_at": { "$ref": "_common.json#/$defs/timestamp" },
    "request": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": { "title": { "type": "string" }, "body": { "type": ["string", "null"] } }
    },
    "reference": {
      "type": "object",
      "required": ["merged_commit"],
      "additionalProperties": false,
      "properties": {
        "merged_commit": { "$ref": "_common.json#/$defs/gitSha" },
        "tests": { "type": "array", "items": { "type": "string" } }
      }
    },
    "grading": {
      "type": "object",
      "required": ["must_pass", "rubric"],
      "additionalProperties": false,
      "properties": {
        "must_pass": { "type": "array", "items": { "type": "string" } },
        "rubric": { "type": "string" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
