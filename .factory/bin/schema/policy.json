{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/policy.json",
  "title": "Policy",
  "description": "policy.yaml \u2014 who can start work and which paths each pipeline may change. The gates always read it from main. Doc 09.",
  "type": "object",
  "required": [
    "schema",
    "trust",
    "paths",
    "pipelines",
    "tests",
    "weakening"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "policy/1"
    },
    "trust": {
      "type": "object",
      "required": [
        "associations",
        "accept_label"
      ],
      "additionalProperties": false,
      "properties": {
        "associations": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "OWNER",
              "MEMBER",
              "COLLABORATOR"
            ]
          },
          "minItems": 1
        },
        "accept_label": {
          "type": "string",
          "minLength": 1
        },
        "harden_label": {
          "type": "string"
        },
        "require_write_access": {
          "type": "boolean",
          "default": true
        },
        "integration_bots": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Bot accounts whose issues wait like outside issues. Trust belongs to people, never integrations."
        }
      }
    },
    "paths": {
      "type": "object",
      "required": [
        "definition",
        "guardrails",
        "tests",
        "protected"
      ],
      "additionalProperties": false,
      "properties": {
        "definition": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "guardrails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tests": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "protected": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "baselines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "required": [
        "product_work",
        "gardening",
        "hardening",
        "definition"
      ],
      "additionalProperties": false,
      "properties": {
        "product_work": {
          "$ref": "#/$defs/pipelineRule"
        },
        "gardening": {
          "$ref": "#/$defs/pipelineRule"
        },
        "hardening": {
          "$ref": "#/$defs/pipelineRule"
        },
        "definition": {
          "$ref": "#/$defs/pipelineRule"
        },
        "conflict": {
          "$ref": "#/$defs/pipelineRule"
        }
      }
    },
    "tests": {
      "type": "object",
      "required": [
        "declared_edits"
      ],
      "additionalProperties": false,
      "properties": {
        "declared_edits": {
          "type": "string",
          "enum": [
            "required",
            "off"
          ]
        }
      }
    },
    "runner_upgrades": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": {
          "type": "string"
        },
        "may_change": {
          "type": "string",
          "enum": [
            "runner_pin"
          ]
        },
        "requires": {
          "type": "string",
          "enum": [
            "trusted_human_approval"
          ]
        }
      }
    },
    "weakening": {
      "type": "object",
      "required": [
        "requires",
        "detects"
      ],
      "additionalProperties": false,
      "properties": {
        "requires": {
          "type": "string",
          "enum": [
            "trusted_human_approval"
          ]
        },
        "detects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "rule_removed",
              "rule_loosened",
              "baseline_raised",
              "native_suppressions_added",
              "unpruned_suppressions_allowed",
              "coverage_floor_lowered",
              "skip_without_reason"
            ]
          }
        }
      }
    },
    "protected_files": {
      "type": "object",
      "description": "gh-aw's protected-file policy, passed to each role workflow by factory-run. gh-aw protects every top-level dot-folder by default, .factory/ included (spike \u00a76). .github/ is never excluded.",
      "required": [
        "policy",
        "exclude"
      ],
      "additionalProperties": false,
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "request-review",
            "blocked",
            "fallback-to-issue",
            "allowed"
          ]
        },
        "exclude": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "product_work": {
              "$ref": "#/$defs/protectedExcludeList"
            },
            "gardening": {
              "$ref": "#/$defs/protectedExcludeList"
            },
            "hardening": {
              "$ref": "#/$defs/protectedExcludeList"
            },
            "definition": {
              "$ref": "#/$defs/protectedExcludeList"
            },
            "conflict": {
              "$ref": "#/$defs/protectedExcludeList"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "pipelineRule": {
      "type": "object",
      "required": [
        "may_change"
      ],
      "additionalProperties": false,
      "properties": {
        "may_change": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "code",
              "tests",
              "guardrails:tighten",
              "guardrails",
              "definition"
            ]
          }
        },
        "requires": {
          "type": "string",
          "enum": [
            "trusted_human_approval"
          ]
        }
      }
    },
    "protectedExcludeList": {
      "type": "array",
      "items": {
        "type": "string",
        "not": {
          "pattern": "^\\.github/"
        },
        "description": "Basename, path prefix, or an exact repo-root path when it starts with /."
      }
    }
  }
}
