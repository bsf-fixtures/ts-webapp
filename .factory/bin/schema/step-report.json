{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/step-report.json",
  "title": "Adapter step report",
  "description": "Returned by every adapter for every agent step. Identical for every harness; a step with no token data fails conformance. Doc 09.",
  "type": "object",
  "required": [
    "schema",
    "harness",
    "role",
    "model",
    "exit",
    "duration_sec",
    "tokens",
    "cost_usd",
    "files_changed",
    "transcript"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "step-report/1"
    },
    "harness": {
      "$ref": "_common.json#/$defs/harness"
    },
    "role": {
      "$ref": "_common.json#/$defs/role"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "exit": {
      "type": "string",
      "enum": [
        "ok",
        "error",
        "timeout",
        "refused"
      ]
    },
    "duration_sec": {
      "$ref": "_common.json#/$defs/seconds"
    },
    "tokens": {
      "type": "object",
      "required": [
        "in",
        "out"
      ],
      "additionalProperties": false,
      "properties": {
        "in": {
          "type": "integer",
          "minimum": 0
        },
        "out": {
          "type": "integer",
          "minimum": 0
        },
        "cached": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cost_usd": {
      "$ref": "_common.json#/$defs/usd"
    },
    "cost_source": {
      "type": "string",
      "enum": [
        "session_log",
        "price_table",
        "unknown"
      ],
      "description": "The session log's own cost is kept; the LiteLLM table is used only when the log records none; `unknown` means neither was available, in which case cost_usd is 0 and must not be read as a measured zero."
    },
    "usage_source": {
      "type": "string",
      "enum": [
        "agent_session",
        "token_usage",
        "harness_log"
      ],
      "description": "Which evidence the token counts came from: gh-aw's normalized agent session, its API proxy's metering, or the harness's own log read with memex. Absent when no source had any."
    },
    "files_changed": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transcript": {
      "type": "string",
      "minLength": 1
    }
  }
}
