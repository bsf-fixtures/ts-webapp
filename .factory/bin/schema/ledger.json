{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/ledger.json",
  "title": "Work ledger",
  "description": "The shared view every pipeline checks before starting work, plus the merge queue's order. Derived: rollup rebuilds it from work-item files and open PRs. Doc 09.",
  "type": "object",
  "required": ["schema", "updated_at", "open", "recent", "merge_queue"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "ledger/1" },
    "updated_at": { "$ref": "_common.json#/$defs/timestamp" },
    "open": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["work_item", "pipeline", "status"],
        "additionalProperties": false,
        "properties": {
          "work_item": { "$ref": "_common.json#/$defs/workItemId" },
          "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
          "status": { "type": "string" },
          "fingerprint": { "$ref": "_common.json#/$defs/sha256" },
          "pr": { "type": ["integer", "null"] },
          "priority": { "type": "string", "enum": ["high", "normal"] },
          "created_at": { "$ref": "_common.json#/$defs/timestamp" },
          "fixes": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Rule violations or problem classes this run is fixing, so gardening and hardening never re-fix what an open PR already fixes."
          }
        }
      }
    },
    "recent": {
      "type": "array",
      "description": "30 days; older entries live only in run files.",
      "items": {
        "type": "object",
        "required": ["work_item", "status"],
        "additionalProperties": false,
        "properties": {
          "work_item": { "$ref": "_common.json#/$defs/workItemId" },
          "status": { "type": "string" },
          "merged_at": { "$ref": "_common.json#/$defs/timestamp" },
          "fingerprint": { "$ref": "_common.json#/$defs/sha256" },
          "pr": { "type": ["integer", "null"] }
        }
      }
    },
    "merge_queue": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["pr", "eligible_at"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "eligible_at": { "$ref": "_common.json#/$defs/timestamp" },
          "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
          "work_item": { "$ref": "_common.json#/$defs/workItemId" }
        }
      }
    }
  }
}
