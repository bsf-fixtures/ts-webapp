{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/review.json",
  "title": "Review report",
  "description": "What the scheduled review found and where each failure was routed. Doc 09.",
  "type": "object",
  "required": ["schema", "id", "window", "scores", "problems"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "review/1" },
    "id": { "$ref": "_common.json#/$defs/reviewId" },
    "window": {
      "type": "object",
      "required": ["from", "to", "runs"],
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "_common.json#/$defs/timestamp" },
        "to": { "$ref": "_common.json#/$defs/timestamp" },
        "runs": { "type": "integer", "minimum": 0 }
      }
    },
    "scores": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["run", "criterion", "score"],
        "additionalProperties": false,
        "properties": {
          "run": { "$ref": "_common.json#/$defs/runId" },
          "criterion": { "type": "string" },
          "score": { "type": "integer", "minimum": 1, "maximum": 5 },
          "tags": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "problems": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "route"],
        "additionalProperties": false,
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "runs": { "type": "array", "items": { "$ref": "_common.json#/$defs/runId" } },
          "route": { "type": "string", "enum": ["hardening", "definition"] },
          "work_item": { "oneOf": [{ "$ref": "_common.json#/$defs/workItemId" }, { "type": "null" }] },
          "change": { "type": "string" },
          "pr": { "type": ["integer", "null"] },
          "benchmark": {
            "type": "object",
            "required": ["tasks", "repeats", "before", "after"],
            "additionalProperties": false,
            "properties": {
              "tasks": { "type": "integer", "minimum": 10 },
              "repeats": { "type": "integer", "minimum": 3 },
              "failure_tasks": { "type": "integer", "minimum": 0 },
              "before": { "$ref": "#/$defs/benchSide" },
              "after": { "$ref": "#/$defs/benchSide" },
              "failure_tasks_before": { "$ref": "_common.json#/$defs/ratio" },
              "failure_tasks_after": { "$ref": "_common.json#/$defs/ratio" },
              "regressions": { "type": "integer", "minimum": 0 },
              "cost_change_pct": { "type": "number" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "benchSide": {
      "type": "object",
      "required": ["mean", "spread"],
      "additionalProperties": false,
      "properties": {
        "mean": { "$ref": "_common.json#/$defs/ratio" },
        "spread": { "type": "number", "minimum": 0 },
        "cost_usd": { "$ref": "_common.json#/$defs/usd" }
      }
    }
  }
}
