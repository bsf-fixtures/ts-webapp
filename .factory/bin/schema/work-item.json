{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://build-software-factory.dev/schema/work-item.json",
  "title": "Work item",
  "description": "One standard work item, written by intake from any trigger. Doc 09.",
  "type": "object",
  "required": ["schema", "id", "created_at", "source", "trigger_class", "pipeline", "title", "status"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "work-item/1" },
    "id": { "$ref": "_common.json#/$defs/workItemId" },
    "created_at": { "$ref": "_common.json#/$defs/timestamp" },
    "source": {
      "type": "object",
      "required": ["kind", "actor"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string",
          "enum": ["issue", "issue_comment", "review_comment", "pr", "schedule", "ci_failure", "dashboard", "review", "gardener", "conflict", "correction"]
        },
        "ref": { "type": ["string", "null"] },
        "actor": { "type": "string", "minLength": 1 },
        "via": { "type": ["string", "null"], "enum": ["slack", "linear", "sentry", null] }
      }
    },
    "trigger_class": { "$ref": "_common.json#/$defs/triggerClass" },
    "pipeline": { "$ref": "_common.json#/$defs/pipeline" },
    "title": { "type": "string", "minLength": 1 },
    "body": { "type": ["string", "null"] },
    "priority": { "type": "string", "enum": ["high", "normal"], "default": "normal" },
    "fingerprint": { "$ref": "_common.json#/$defs/sha256" },
    "status": {
      "type": "string",
      "enum": ["queued", "running", "in_review", "queued_to_merge", "merged", "escalated", "duplicate", "rejected", "waiting_trust", "needs_info"]
    },
    "runs": { "type": "array", "items": { "$ref": "_common.json#/$defs/runId" } },
    "pr": { "type": ["integer", "null"], "minimum": 1 },
    "parent": { "oneOf": [{ "$ref": "_common.json#/$defs/workItemId" }, { "type": "null" }] },
    "related": { "type": "array", "items": { "$ref": "_common.json#/$defs/workItemId" } },
    "spec": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["plan", "acceptance_checks"],
          "additionalProperties": false,
          "properties": {
            "plan": { "type": "string", "minLength": 1 },
            "files": { "type": "array", "items": { "type": "string" } },
            "feature_folders": { "type": "array", "items": { "type": "string" } },
            "acceptance_checks": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
            "tests_added": { "type": "array", "items": { "type": "string" } },
            "tests_changed": {
              "type": "array",
              "items": { "type": "string" },
              "description": "Existing test files this build may modify or delete. The policy check fails any other test edit."
            }
          }
        }
      ]
    }
  }
}
